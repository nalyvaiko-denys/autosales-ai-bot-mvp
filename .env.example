ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://autosales:autosales@postgres:5432/autosales
REDIS_URL=redis://redis:6379/0
CREATE_TABLES_ON_START=false

TELEGRAM_BOT_TOKEN=
MANAGER_CHAT_IDS=
TELEGRAM_ADMIN_IDS=
SALES_PHONE_1=+380440000001
SALES_PHONE_2=+380440000002

# Optional. Without it, AI search uses the deterministic offline parser.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TIMEOUT_SECONDS=10
OPENAI_MAX_RETRIES=2
EMBEDDING_DIMENSIONS=1536

STAFF_API_TOKEN=change-me-to-a-long-random-token
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password
SESSION_SECRET=change-me-to-a-long-random-session-secret
PUBLIC_BASE_URL=http://localhost:8000
